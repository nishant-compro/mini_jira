<% content_for :title, "Projects" %>
<div id="vue-app" data-page="projects" data-props="<%= json_escape({ projects: @projects.map { |project| { id: project.id, name: project.name, ticket_count: project.tickets.size, open_tickets_count: project.open_tickets_count, url: project_path(project) } }, users: @users.map { |user| { id: user.id, name: user.name, email: user.email, initials: user.initials } }, current_user: (@current_user && { id: @current_user.id, name: @current_user.name, email: @current_user.email, initials: @current_user.initials }), user_errors: (@user&.errors&.full_messages || []) }.to_json) %>"></div>
