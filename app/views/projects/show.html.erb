<% content_for :title, @project.name %>
<div id="vue-app" data-page="project" data-props="<%= json_escape({ project: { id: @project.id, name: @project.name, description: @project.description }, tickets: @project.tickets.includes(:assignee).map { |ticket| { id: ticket.id, title: ticket.title, description: ticket.description, status: ticket.status, assignee: (ticket.assignee && { id: ticket.assignee.id, name: ticket.assignee.name, initials: ticket.assignee.initials }), url: project_ticket_path(@project, ticket) } }, status_labels: { todo: "To do", in_progress: "In progress", done: "Done" } }.to_json) %>"></div>
