<% content_for :title, "New Ticket" %>
<div id="vue-app" data-page="new-ticket" data-props="<%= json_escape({ project: { id: @project.id, name: @project.name }, ticket: { title: @ticket.title, description: @ticket.description, status: @ticket.status, assignee_id: @ticket.assignee_id }, users: User.order(:name).map { |user| { id: user.id, name: user.name, initials: user.initials } }, statuses: [{ value: "todo", label: "To do" }, { value: "in_progress", label: "In progress" }, { value: "done", label: "Done" }], errors: @ticket.errors.full_messages }.to_json) %>"></div>