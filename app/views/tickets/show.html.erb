<% content_for :title, @ticket.title %>
<div id="vue-app" data-page="ticket" data-props="<%= json_escape({ project: { id: @project.id, name: @project.name }, ticket: { id: @ticket.id, title: @ticket.title, description: @ticket.description, status: @ticket.status, assignee: (@ticket.assignee && { id: @ticket.assignee.id, name: @ticket.assignee.name, initials: @ticket.assignee.initials }), reporter: (@ticket.reporter && { id: @ticket.reporter.id, name: @ticket.reporter.name, initials: @ticket.reporter.initials }), edit_url: edit_project_ticket_path(@project, @ticket), url: project_ticket_path(@project, @ticket) }, comments: @comments.map { |comment| { id: comment.id, body: comment.body, author: (comment.user && { id: comment.user.id, name: comment.user.name, initials: comment.user.initials }) } }, users: @users.map { |user| { id: user.id, name: user.name, initials: user.initials } }, current_user: (current_user && { id: current_user.id, name: current_user.name, initials: current_user.initials }), comment_errors: (@comment&.errors&.full_messages || []) }.to_json) %>"></div>
